## 10. Predict a Single Image
def predict_image(image_path):
    """Predict vehicle class for a single image and show a bar chart."""
    img_path = str(image_path)
    if not os.path.exists(img_path):
        print(f"Image not found: {img_path}")
        return

    result    = model.predict(img_path, imgsz=224, verbose=False)[0]
    probs     = result.probs.data.cpu().numpy()
    top3_idx  = probs.argsort()[::-1][:3]
    top3      = [(CLASSES[i], probs[i]) for i in top3_idx]

    img = cv2.cvtColor(cv2.imread(img_path), cv2.COLOR_BGR2RGB)
    img = cv2.resize(img, IMG_SIZE)

    fig, axes = plt.subplots(1, 2, figsize=(10, 4))
    axes[0].imshow(img)
    axes[0].axis('off')
    axes[0].set_title(f"Prediction: {top3[0][0]} ({top3[0][1]*100:.1f}%)",
                      fontsize=12, fontweight='bold', color='green')

    names = [c for c, _ in top3]
    confs = [p for _, p in top3]
    bars  = axes[1].barh(names[::-1], confs[::-1],
                         color=['#4c72b0', '#aec6cf', '#d9e8f5'])
    axes[1].set_xlim(0, 1)
    axes[1].set_xlabel('Confidence')
    axes[1].set_title('Top-3 Class Probabilities')
    for bar, val in zip(bars, confs[::-1]):
        axes[1].text(bar.get_width() + 0.01, bar.get_y() + bar.get_height()/2,
                     f'{val*100:.1f}%', va='center', fontsize=9)
    plt.tight_layout()
    plt.show()

    for cls_name, prob in top3:
        print(f"  {cls_name:<12}: {prob*100:.2f}%")

# ── Change this path to your own test image ──────────────────────────────
custom_image_path = r'path/to/your/vehicle_image.jpg'
predict_image(custom_image_path)

## 11. 🔴 Live Webcam Prediction

Run the cell below to start real-time vehicle detection from your webcam.

- **Press `Q`** in the OpenCV window to quit.
- A semi-transparent overlay shows the predicted class and confidence.
- The top-3 probabilities are displayed as a live bar chart in the corner.

def run_live_prediction(camera_index=0):
    """
    Real-time vehicle recognition from webcam.
    - Grayscale pre-processing fed into YOLOv8 (works with colour or grey input)
    - On-screen label with confidence badge
    - Live top-3 bar-chart overlay
    Press Q to quit.
    """
    cap = cv2.VideoCapture(camera_index)
    if not cap.isOpened():
        print(f"❌ Could not open camera {camera_index}")
        return

    # Palette for the 4 classes
    class_colors_bgr = {
        'Bus':        (255, 180,  50),
        'Car':        ( 50, 200,  50),
        'Motorcycle': ( 50, 100, 255),
        'Truck':      ( 50, 210, 255),
    }
    FONT = cv2.FONT_HERSHEY_DUPLEX
    print("🎥 Webcam live — press Q to quit")

    while True:
        ret, frame = cap.read()
        if not ret:
            print("⚠️  Frame capture failed — exiting")
            break

        h, w = frame.shape[:2]

        # ── Inference ────────────────────────────────────────────────────────
        # Convert to grayscale then back to 3-channel so YOLOv8 still gets
        # a 3-channel tensor (it expects H×W×3) while benefiting from grey
        # normalisation that reduces colour-lighting sensitivity.
        gray3 = cv2.cvtColor(cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY), cv2.COLOR_GRAY2BGR)
        result    = model.predict(gray3, imgsz=224, verbose=False)[0]
        probs     = result.probs.data.cpu().numpy()
        top_idx   = int(probs.argmax())
        top_conf  = float(probs.max())
        top_label = CLASSES[top_idx]
        color     = class_colors_bgr.get(top_label, (200, 200, 200))

        # ── Main label badge ─────────────────────────────────────────────────
        label_text = f"{top_label}  {top_conf*100:.1f}%"
        (tw, th), baseline = cv2.getTextSize(label_text, FONT, 1.0, 2)
        pad = 10
        cv2.rectangle(frame, (10, 10), (10 + tw + pad*2, 10 + th + pad*2 + baseline),
                      color, -1)                        # filled badge
        cv2.rectangle(frame, (10, 10), (10 + tw + pad*2, 10 + th + pad*2 + baseline),
                      (255, 255, 255), 2)               # white border
        cv2.putText(frame, label_text, (10 + pad, 10 + th + pad),
                    FONT, 1.0, (0, 0, 0), 2, cv2.LINE_AA)

        # ── Top-3 bar chart overlay (bottom-left) ────────────────────────────
        top3_idx  = probs.argsort()[::-1][:3]
        bar_x, bar_y_start = 10, h - 130
        bar_max_w, bar_h, bar_gap = 180, 24, 8

        for rank, idx in enumerate(top3_idx):
            cls_name = CLASSES[idx]
            prob     = probs[idx]
            c        = class_colors_bgr.get(cls_name, (180, 180, 180))
            y0       = bar_y_start + rank * (bar_h + bar_gap)
            filled_w = int(bar_max_w * prob)

            # Background track
            cv2.rectangle(frame, (bar_x, y0), (bar_x + bar_max_w, y0 + bar_h),
                          (50, 50, 50), -1)
            # Filled portion
            cv2.rectangle(frame, (bar_x, y0), (bar_x + filled_w, y0 + bar_h), c, -1)
            # Label
            cv2.putText(frame, f"{cls_name}: {prob*100:.0f}%",
                        (bar_x + bar_max_w + 6, y0 + bar_h - 4),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 255, 255), 1, cv2.LINE_AA)

        # ── FPS hint ─────────────────────────────────────────────────────────
        cv2.putText(frame, "Press Q to quit", (w - 190, h - 12),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, (180, 180, 180), 1, cv2.LINE_AA)

        cv2.imshow("Vehicle Recognition — Live", frame)

        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()
    print("✅ Webcam closed")

# ── Launch live prediction ───────────────────────────────────────────────
run_live_prediction(camera_index=0)   # change index if using an external camera

## 12. Predict on a Video File
def predict_video(video_path, output_path='results/output_video.mp4'):
    """
    Run vehicle recognition on a saved video file.
    Output is saved with the label overlay burned in.
    """
    cap = cv2.VideoCapture(video_path)
    if not cap.isOpened():
        print(f"❌ Could not open video: {video_path}")
        return

    fps  = cap.get(cv2.CAP_PROP_FPS)
    w    = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    h    = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    out  = cv2.VideoWriter(output_path, cv2.VideoWriter_fourcc(*'mp4v'), fps, (w, h))
    FONT = cv2.FONT_HERSHEY_DUPLEX
    count = 0

    while True:
        ret, frame = cap.read()
        if not ret:
            break
        count += 1

        gray3  = cv2.cvtColor(cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY), cv2.COLOR_GRAY2BGR)
        result = model.predict(gray3, imgsz=224, verbose=False)[0]
        probs  = result.probs.data.cpu().numpy()
        pred_idx  = int(probs.argmax())
        pred_conf = float(probs.max())
        label     = f"{CLASSES[pred_idx]}  {pred_conf*100:.1f}%"

        cv2.putText(frame, label, (20, 45), FONT, 1.3, (0, 0, 0), 4, cv2.LINE_AA)
        cv2.putText(frame, label, (20, 45), FONT, 1.3, (0, 255, 0), 2, cv2.LINE_AA)
        out.write(frame)

    cap.release()
    out.release()
    print(f"✅ Processed {count} frames — saved to {output_path}")

